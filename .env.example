# Copy to .env (gitignored). mgdvault loads the nearest .env above the working
# directory automatically, without overriding variables already exported.
# Set MGDVAULT_DOTENV=0 to disable that, or point it at another file.

MGDVAULT_PASSWORD=change-me
# MGDVAULT_PATH=./.secrets/vault.kdbx
# MGDVAULT_BACKEND=keepass        # keepass | keyring | env | memory
# MGDVAULT_KEYFILE=~/.config/mgdvault/key.bin
# MGDVAULT_LOCK_TIMEOUT=30
